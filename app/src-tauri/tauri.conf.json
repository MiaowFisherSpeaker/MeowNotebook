{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MeowNotebook",
  "version": "1.1.2",
  "identifier": "io.github.miaowfisherspeaker.meownotebook",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "MeowNotebook",
        "url": "index.html",
        "width": 1320,
        "height": 860,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "backgroundThrottling": "throttle"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "MeowNotebook 桌面客户端",
    "copyright": "MiaowFisherSpeaker",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser", "languages": ["SimpChinese", "English"] }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRERUYxQjgwRDRCMjcyM0QKUldROWNyTFVnQnZ2VFliRzI2TTVGZFZDazE0ZVNHd1Y2V2VuMldtdkMvSmVFeC9jK0ErSGxpZDYK",
      "endpoints": [
        "https://github.com/MiaowFisherSpeaker/MeowNotebook/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
